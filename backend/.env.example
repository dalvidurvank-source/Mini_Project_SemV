# Obtain a personal key after logging in at https://www.data.gov.in/.
# The public documentation's sample key is capped at 10 records per response.
DATA_GOV_IN_API_KEY=

# Engineering safeguards; changing these requires regenerating the report.
AGROLINK_FRESHNESS_DAYS=7
AGROLINK_PO_MAX_GAP_DAYS=7

# Optional OSRM deployment; default uses the public OSRM service for custom pins.
# Saved prototype routes work without network access.
# AGROLINK_OSRM_URL=https://router.project-osrm.org

# Backend-maintained matched supply/demand evidence; never populated by the farmer.
# See data/market_balance.example.csv and README.md for the required contract.
# AGROLINK_BALANCE_CSV=data/market_balance.csv
AGROLINK_DSR_SENSITIVITY=0.10

# Optional operator-maintained buyer directory and offer terms.
# Default data/buyers.demo.json has no offer prices and stays financially unranked.
# Browser tests use backend/test_fixtures/buyer_offers.demo.json explicitly.
# AGROLINK_BUYERS_FILE=data/buyers.demo.json

# New accounts, harvests, photos and buyer offers (separate from market imports).
# Default creates/migrates data/agrolink_app.sqlite3 automatically.
# AGROLINK_APP_DB=data/agrolink_app.sqlite3
# Required when accessing a separately hosted frontend; use its exact origin.
# AGROLINK_FRONTEND_ORIGIN=http://localhost:5173
# Enable only behind HTTPS for deployed accounts; local HTTP needs this unset.
# AGROLINK_COOKIE_SECURE=1
